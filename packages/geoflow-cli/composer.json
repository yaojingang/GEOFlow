{
    "name": "yaojingang/geoflow-cli",
    "description": "Standalone GEOFlow remote management client",
    "type": "project",
    "license": "AGPL-3.0-only",
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-fileinfo": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-phar": "*",
        "ext-sodium": "*",
        "illuminate/http": "^12.64",
        "symfony/console": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "App\\Console\\GeoFlowCli\\": "src/",
            "App\\Support\\Api\\": "contracts/"
        }
    },
    "config": {
        "platform": {"php": "8.3.0"},
        "allow-plugins": false,
        "sort-packages": true
    }
}
