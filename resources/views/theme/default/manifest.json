{
  "id": "default",
  "name": "默认主题（占位）",
  "version": "1.0.0",
  "description": "在 theme/default/ 下按需添加 home、article、category、about 等 Blade 即可覆盖 site.*；未提供的页面自动使用内置 site 模板。",
  "requires": {
    "views": [
      "site.partials.friend-links"
    ]
  },
    "topic": {
        "contract": 1,
        "layouts": [
            {
                "id": "default",
                "name": "标准聚合",
                "view": "site.topics.templates.default"
            },
            {
                "id": "guide",
                "name": "阅读指南",
                "view": "site.topics.templates.guide"
            },
            {
                "id": "roundup",
                "name": "资讯盘点",
                "view": "site.topics.templates.roundup"
            }
        ],
        "homepage_module": {
            "view": "site.partials.topic-home",
            "enabled": true
        }
    }
}
