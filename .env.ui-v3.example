APP_NAME="GEOFlow UI V3"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:28080
SITE_URL=http://localhost:28080
APP_PORT=28080
ADMIN_BASE_PATH=admin
# 外层代理以固定单层目录发布时填写，例如 /docs；候选环境默认使用站点根目录。
GEOFLOW_FORWARDED_PREFIX=

DB_DATABASE=geo_flow_ui_v3
DB_USERNAME=geo_ui_v3
DB_PASSWORD=change-me-before-first-start
DB_EXPOSE_PORT=35432
POSTGRES_CONTAINER_DATA_DIR=/var/lib/postgresql/data
REDIS_EXPOSE_PORT=36379

SESSION_COOKIE=geoflow_ui_v3_session
CACHE_PREFIX=geoflow_ui_v3_cache

REVERB_HOST=localhost
REVERB_PORT=28080
REVERB_ALLOWED_ORIGINS=localhost:28080

GEOFLOW_ADMIN_USERNAME=admin
GEOFLOW_ADMIN_EMAIL=admin@ui-v3.local
GEOFLOW_ADMIN_PASSWORD=change-me-before-first-start
# 候选环境禁止导入演示内容。
GEOFLOW_SEED_FRONTEND_DEMO=false
GEOFLOW_SEED_FRONTEND_DEMO_OVERWRITE=false
GEOFLOW_TELEMETRY_ENABLED=false
GEOFLOW_UPDATE_CHECK_ENABLED=false
GEOFLOW_UPDATE_EXECUTION_ENABLED=false
GEOFLOW_ADMIN_UI_V3_ENABLED=true
