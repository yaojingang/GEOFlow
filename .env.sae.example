# SAE 环境变量模板
#
# 该文件只用于把配置复制到 SAE 控制台/配置中心，不要直接作为生产 .env
# 提交或把密码写入仓库。APP_KEY、数据库/Redis/OSS/AI 密钥必须放在 SAE Secret。

APP_NAME=GEOFlow
APP_ENV=production
APP_DEBUG=false
# 必须在 SAE Secret 中填入一次生成后长期不变的 base64:... 值。
APP_KEY=
APP_URL=https://your-domain.example
APP_TIMEZONE=Asia/Shanghai

GEOFLOW_SAE_RUNTIME=true
GEOFLOW_ALLOW_MISSING_ENV_FILE=true
SAE_ROLE=web
AUTO_WAIT_FOR_DB=true
# 常驻 SAE 角色必须全部关闭；迁移使用独立 release 任务。
AUTO_MIGRATE=false
AUTO_INSTALL_ONCE=false
AUTO_OPTIMIZE=false

DB_CONNECTION=mysql
DB_HOST=your-rds-private-host
DB_PORT=3306
DB_DATABASE=geoflow
DB_USERNAME=geoflow_runtime
DB_PASSWORD=put-in-sae-secret
GEOFLOW_VECTOR_CAPABILITY_CACHE_TTL_SECONDS=60

REDIS_CLIENT=phpredis
REDIS_HOST=your-redis-private-host
REDIS_PORT=6379
REDIS_PASSWORD=put-in-sae-secret-if-enabled
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_LIMITER_STORE=redis

# 首期挂载 NAS 到 /var/www/html/storage，保持项目当前 POSIX 文件语义。
FILESYSTEM_DISK=local
FILESYSTEM_LOCAL_ROOT=/var/www/html/storage/app/private
FILESYSTEM_PUBLIC_ROOT=/var/www/html/storage/app/public
NAS_STORAGE_ROOT=/var/www/html/storage/app

GEOFLOW_NGINX_PRIMARY_HOST=your-domain.example
GEOFLOW_NGINX_PRIMARY_ALIASES=
GEOFLOW_NGINX_HOSTED_ROOT_DOMAIN=invalid
GEOFLOW_NGINX_PUBLIC_SCHEME=https
GEOFLOW_NGINX_PUBLIC_PORT=443
GEOFLOW_PHP_FPM_UPSTREAM=127.0.0.1:9000
# Reverb 使用域名时填 SAE/VPC 可达的 DNS resolver；使用 IP 时可留默认值。
GEOFLOW_NGINX_RESOLVER=127.0.0.11
GEOFLOW_REVERB_UPSTREAM=your-reverb-private-host:18080

REVERB_APP_ID=geoflow-reverb-app
REVERB_APP_KEY=put-in-sae-secret
REVERB_APP_SECRET=put-in-sae-secret
REVERB_HOST=your-domain.example
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_BROADCAST_HOST=your-reverb-private-host
REVERB_BROADCAST_PORT=18080
REVERB_BROADCAST_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=18080
REVERB_ALLOWED_ORIGINS=your-domain.example

# 若已完成对应业务代码的流式对象存储适配，再按需启用；不要仅改这一项。
AWS_ACCESS_KEY_ID=put-in-sae-secret
AWS_SECRET_ACCESS_KEY=put-in-sae-secret
AWS_DEFAULT_REGION=cn-shenzhen
AWS_BUCKET=your-oss-bucket
AWS_ENDPOINT=https://oss-cn-shenzhen.aliyuncs.com
AWS_USE_PATH_STYLE_ENDPOINT=false
# 可选的 OSS 显式 disk；首期 POSIX 路径仍使用 NAS/local。
OSS_ACCESS_KEY_ID=put-in-sae-secret
OSS_ACCESS_KEY_SECRET=put-in-sae-secret
OSS_REGION=cn-shenzhen
OSS_BUCKET=your-oss-bucket
OSS_ENDPOINT=https://oss-cn-shenzhen.aliyuncs.com
OSS_USE_PATH_STYLE_ENDPOINT=false

LOG_CHANNEL=stderr
LOG_LEVEL=warning
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
MAIL_MAILER=log
