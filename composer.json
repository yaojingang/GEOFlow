{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "yaojingang/geoflow",
    "type": "project",
    "description": "Open-source GEO operations platform for enterprise websites, with trusted knowledge, AI quality gates, human review, multi-site delivery, and analytics.",
    "keywords": ["geoflow", "geo", "generative-engine-optimization", "content-engineering", "laravel", "multi-site", "ai"],
    "license": "AGPL-3.0-only",
    "require": {
        "php": "^8.3",
        "composer/semver": "^3.4",
        "laravel/ai": "^0.10.3",
        "laravel/framework": "^12.0",
        "laravel/horizon": "^5.45",
        "laravel/reverb": "^1.0",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^2.10.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/boost": "^2.4",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5.50"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#86efac,#fb7185,#fdba74,#f0abfc,#67e8f9,#f9a8d4\" \"php artisan serve\" \"php artisan queue:listen --queue=system-updates,geoflow,distribution,theme-replication,default --tries=1 --timeout=930\" \"php artisan geoflow:work-ai-quality front\" \"php artisan geoflow:work-ai-quality backfill\" \"php artisan geoflow:work-ai-optimization\" \"php artisan reverb:start\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,quality,quality-backfill,optimization,reverb,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "version:check": [
            "@php artisan config:clear --ansi",
            "@php artisan test --compact tests/Unit/ReleaseVersionMappingTest.php"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
